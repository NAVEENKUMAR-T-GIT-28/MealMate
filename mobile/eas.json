{
  "cli": {
    "version": ">= 21.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mealmate-backend-y9g5.onrender.com",
        "EXPO_PUBLIC_WEB_URL": "https://meal-mate-tracker.vercel.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mealmate-backend-y9g5.onrender.com",
        "EXPO_PUBLIC_WEB_URL": "https://meal-mate-tracker.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
